{
  "name": "site-quality-gate",
  "private": true,
  "scripts": {
    "start": "node app/server.js",
    "test": "npm run test:unit && playwright test",
    "test:unit": "node --test \"tests/unit/*.test.*\"",
    "test:contract": "playwright test --project=contract",
    "test:smoke": "playwright test --project=smoke --no-deps",
    "test:regression": "playwright test --project=regression --no-deps"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.51.0",
    "ajv": "^8.20.0"
  }
}
