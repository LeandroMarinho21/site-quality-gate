{
  "$id": "order-created",
  "type": "object",
  "required": ["ok", "order"],
  "properties": {
    "ok": { "const": true },
    "order": {
      "type": "object",
      "required": ["id", "customer", "items", "total", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^NB-\\d{4,}$" },
        "customer": {
          "type": "object",
          "required": ["name", "email", "cep"],
          "properties": {
            "name": { "type": "string", "minLength": 2 },
            "email": { "type": "string" },
            "cep": { "type": "string", "pattern": "^\\d{5}-\\d{3}$" }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sku", "name", "qty", "price"],
            "properties": {
              "sku": { "type": "string" },
              "name": { "type": "string" },
              "qty": { "type": "integer", "minimum": 1 },
              "price": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "total": { "type": "number", "exclusiveMinimum": 0 },
        "version": { "type": "string" }
      }
    }
  }
}
